FROM node:24-bookworm AS pimclaw-builder

WORKDIR /build/pimclaw

COPY package.json package-lock.json tsconfig.json ./
COPY index.ts openclaw.plugin.json AGENTS.md ./
COPY src ./src

RUN npm ci && npm run build && npm prune --omit=dev

FROM alpine/openclaw:2026.4.1

USER root

RUN mkdir -p /app/extensions/pimclaw \
    /home/node/.openclaw/workspaces/pimclaw-head \
    /home/node/.openclaw/workspaces/pimclaw-planner

COPY --from=pimclaw-builder /build/pimclaw/package.json /app/extensions/pimclaw/package.json
COPY --from=pimclaw-builder /build/pimclaw/package-lock.json /app/extensions/pimclaw/package-lock.json
COPY --from=pimclaw-builder /build/pimclaw/index.ts /app/extensions/pimclaw/index.ts
COPY --from=pimclaw-builder /build/pimclaw/openclaw.plugin.json /app/extensions/pimclaw/openclaw.plugin.json
COPY --from=pimclaw-builder /build/pimclaw/AGENTS.md /app/extensions/pimclaw/AGENTS.md
COPY --from=pimclaw-builder /build/pimclaw/dist /app/extensions/pimclaw/dist
COPY --from=pimclaw-builder /build/pimclaw/node_modules /app/extensions/pimclaw/node_modules

RUN ln -s /app /app/extensions/pimclaw/node_modules/openclaw \
    && chown -R node:node /app/extensions/pimclaw /home/node/.openclaw/workspaces

USER node

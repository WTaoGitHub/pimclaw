sequenceDiagram
    participant Head as Head Agent
    participant Tool as pimclaw_submit_anomalies
    participant Receiver as AnomalyReceiver
    participant Recorder as TaskStatusRecorder
    participant Trigger as PlannerTrigger
    participant Planner as Planner Agent
    participant PlanTool as pimclaw_plan_task
    participant Scheduler as Scheduler

    Head->>Tool: submit anomaly events
    Tool->>Receiver: receive(events)
    Receiver->>Receiver: validate type/severity/metric/values/deployment
    Receiver->>Receiver: dedupe by metricName+deploymentName
    alt accepted event
        Receiver->>Recorder: create task(status=planning, taskType=pending-plan)
        Receiver->>Tool: return taskId + eventId
        Receiver->>Trigger: trigger planner asynchronously
        Trigger->>Planner: launch pimclaw-planner with event payload
        alt planner submits plan
            Planner->>PlanTool: pimclaw_plan_task(taskId, config, reasoning)
            PlanTool->>Recorder: update task planning -> ready
            Scheduler->>Recorder: pick up ready task later
        else trigger fails or planner times out
            Tool->>Recorder: apply fallback plan
            Tool->>Recorder: update task planning -> ready
        end
    else invalid or duplicate event
        Receiver-->>Tool: skip event
    end
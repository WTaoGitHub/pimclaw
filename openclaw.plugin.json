{
  "id": "pimclaw",
  "enabledByDefault": false,
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "anomalyReceiver": {
        "type": "object",
        "properties": {
          "maxEventsPerSubmission": { "type": "number", "default": 20 },
          "deduplicationWindowMs": { "type": "number", "default": 600000 },
          "planningTimeoutMs": { "type": "number", "default": 600000 },
          "allowedMetrics": { "type": "array", "items": { "type": "string" } }
        }
      },
      "planner": {
        "type": "object",
        "properties": {
          "agentId": { "type": "string", "default": "pimclaw-planner" },
          "timeoutSeconds": { "type": "number", "default": 600 },
          "workspaceDir": { "type": "string", "default": ".pimclaw-agents/planner" },
          "fallbackTaskType": { "type": "string", "default": "scale-up" },
          "fallbackConfig": { "type": "object" }
        }
      },
      "headFeedback": {
        "type": "object",
        "properties": {
          "settlingDelayMs": {
            "type": "number",
            "default": 900000,
            "description": "Minimum delay after task completion before Head follow-up feedback becomes eligible."
          },
          "feedbackValidityMs": {
            "type": "number",
            "default": 3600000,
            "description": "Maximum age after task completion for Head follow-up feedback to remain valid."
          }
        }
      },
      "prometheus": {
        "type": "object",
        "properties": {
          "baseUrl": { "type": "string" },
          "engine": {
            "oneOf": [
              { "type": "string", "enum": ["vllm", "sglang"] },
              { "type": "array", "items": { "type": "string", "enum": ["vllm", "sglang"] } }
            ],
            "description": "Inference engine(s) to query. Accepts a single engine name or an array. Default: all engines."
          },
          "queryOverrides": { "type": "object", "additionalProperties": { "type": "string" } },
          "defaultLabels": { "type": "object", "additionalProperties": { "type": "string" } },
          "timeoutMs": { "type": "number", "default": 10000 },
          "username": { "type": "string" },
          "password": { "type": "string" },
          "bearerToken": { "type": "string" }
        },
        "required": ["baseUrl"]
      },
      "engineMcp": {
        "type": "object",
        "properties": {
          "sseUrl": { "type": "string", "description": "MCP server SSE endpoint URL" },
          "username": { "type": "string", "description": "Platform login username" },
          "password": { "type": "string", "description": "Platform login password" },
          "tenantId": { "type": "string", "description": "Tenant/org ID. If omitted, auto-selects first tenant." },
          "tokenRefreshMarginMs": { "type": "number", "default": 300000, "description": "Refresh token this many ms before expiry" }
        },
        "required": ["sseUrl", "username", "password"]
      },
      "perfMcp": {
        "type": "object",
        "properties": {
          "pythonPath": { "type": "string", "default": "python3.12", "description": "Path to Python interpreter" },
          "serverScriptPath": { "type": "string", "description": "Absolute path to perfllm_mcp_server.py" },
          "env": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Extra env vars for the Python process" }
        },
        "required": ["serverScriptPath"]
      },
      "simMcp": {
        "type": "object",
        "properties": {
          "sseUrl": { "type": "string", "description": "Hisim MCP server SSE endpoint URL" }
        },
        "required": ["sseUrl"]
      }
    }
  },
  "contracts": {
    "tools": [
      "pimclaw_submit_anomalies",
      "pimclaw_submit_task_feedback",
      "pimclaw_plan_task",
      "pimclaw_route_task",
      "pimclaw_list_components",
      "pimclaw_component_status",
      "pimclaw_health",
      "pimclaw_task_counts",
      "pimclaw_list_tasks",
      "pimclaw_retry_task",
      "pimclaw_revoke_task",
      "pimclaw_query_metrics",
      "pimclaw_query_perfllm",
      "pimclaw_get_perfllm_schema",
      "pimclaw_sim_register_hardware",
      "pimclaw_sim_list_hardware",
      "pimclaw_sim_start",
      "pimclaw_sim_stop",
      "pimclaw_sim_status",
      "pimclaw_sim_benchmark",
      "pimclaw_sim_dataset_info"
    ]
  }
}
